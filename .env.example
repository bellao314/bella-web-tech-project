# ==============================================================================
# Environment Configuration Template for Docker & Local Deployment
# Copy this file to .env before starting containers: `cp .env.example .env`
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=mobile_vendor
POSTGRES_PORT=5432

# Backend API Configuration
PORT=3000
API_PORT=3000
JWT_SECRET=mobile_vendor_super_secret_jwt_key_2026
BASE_URL=http://localhost

# Database connection URL for API (formatted automatically in docker-compose)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/mobile_vendor

# Google Maps API Key (Used by backend proxy routes and frontend map viewer)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_API_KEY=your_google_maps_api_key_here

# Postmark Email Service (Optional: for password reset emails)
POSTMARK_API_TOKEN=your_postmark_api_token_here

# Container Startup Controls
RUN_MIGRATIONS=true
SEED_DATABASE=false

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_URL=/api
