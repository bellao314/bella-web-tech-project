// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  name      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  location  
}